# Copy this file to .env. The values are for a local lab container only.
# The instance listens on 127.0.0.1 and holds nothing but synthetic data.

# SA password for the lab container (SQL Server enforces its complexity policy).
MSSQL_SA_PASSWORD=Lab_Only-Passw0rd

# Image tag. Pin a specific cumulative update here to rehearse patching
# (see docs/runbooks/SOP-03-patching-and-upgrades.md).
MSSQL_IMAGE_TAG=2022-latest

# Host port for SSMS or Azure Data Studio: localhost,14330
MSSQL_HOST_PORT=14330
